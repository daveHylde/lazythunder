{
  "manifest_version": 2,
  "name": "lazythunder",
  "version": "1.0.0",
  "description": "Native-messaging bridge between Thunderbird and the lazythunder TUI",
  "browser_specific_settings": {
    "gecko": {
      "id": "lazythunder@lazythunder.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "messagesDelete",
    "compose",
    "compose.send",
    "compose.save",
    "accountsIdentities"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "accountsAdmin": {
      "schema": "experiments/accountsAdmin/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "accountsAdmin"
          ]
        ],
        "script": "experiments/accountsAdmin/implementation.js"
      }
    }
  }
}
